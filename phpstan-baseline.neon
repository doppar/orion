			count: 1
			path: src/OrionLauncher.php

		-
			message: '#^Call to function is_string\(\) with string will always evaluate to true\.$#'
			identifier: function.alreadyNarrowedType
			count: 1
			path: src/Process/InteractsWithCommandSanitization.php

		-
			message: '#^Method Doppar\\Orion\\Process\\ProcessPipeline\:\:sanitizeCommand\(\) has parameter \$command with no value type specified in iterable type array\.$#'
