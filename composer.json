{
    "name": "doppar/orion",
    "description": "External process orchestration for Doppar — run shell commands individually, in concurrency-limited pools, or chained into piped pipelines.",
    "type": "library",
    "license": "MIT",
    "support": {
        "issues": "https://github.com/doppar/orion/issues",
        "source": "https://github.com/doppar/orion"
    },
    "authors": [
        {
            "name": "Mahedi Hasan",
            "email": "mahedy150101@gmail.com"
        }
    ],
    "require-dev": {
        "mockery/mockery": "^1.6",
        "phpunit/phpunit": "^13.3"
    },
    "autoload": {
        "psr-4": {
            "Doppar\\Orion\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Doppar\\Orion\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": "^8.5",
        "symfony/process": "^8.1"
    }
}